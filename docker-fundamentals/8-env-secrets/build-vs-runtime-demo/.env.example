# Run-time configuration — inject at container start (Compose env_file, docker run -e).
# Copy to .env for local stacks; never commit real production secrets.

APP_ENV=local
DB_HOST=db
DB_DATABASE=app
REDIS_HOST=redis
LOG_LEVEL=debug

# Placeholders only — set real values in your secret store / CI, not in git:
# DB_PASSWORD=
# APP_KEY=
